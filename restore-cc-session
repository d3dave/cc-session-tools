#!/usr/bin/env python3
"""Restore an archived Claude Code session into the current project directory.

Usage: restore-cc-session <session.zip>
"""

import json, os, sys, zipfile
from pathlib import Path

if len(sys.argv) < 2:
    sys.exit("usage: restore-cc-session <session.zip>")

archive = Path(sys.argv[1])
if not archive.is_file():
    sys.exit(f"not found: {archive}")

new_path = os.getcwd()
projects_dir = Path(os.environ.get("CLAUDE_DIR", Path.home() / ".claude")) / "projects"
new_project = projects_dir / new_path.replace("/", "-")

with zipfile.ZipFile(archive) as zf:
    session_jsonls = [n for n in zf.namelist() if n.endswith(".jsonl") and "/" not in n]
    if not session_jsonls:
        sys.exit("no session .jsonl found in archive")

    old_path = None
    for line in zf.read(session_jsonls[0]).decode().splitlines():
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            continue
        if "cwd" in entry:
            old_path = entry["cwd"]
            break

    if not old_path:
        sys.exit("could not detect original path from session data")

    need_rewrite = old_path != new_path
    new_project.mkdir(parents=True, exist_ok=True)
    if need_rewrite:
        print(f"Rewriting: {old_path} -> {new_path}\n")

    for name in zf.namelist():
        dst = new_project / name
        if dst.exists():
            print(f"  skip {name}")
            continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        data = zf.read(name)
        if need_rewrite and name.endswith((".jsonl", ".json")):
            data = data.replace(old_path.encode(), new_path.encode())
        dst.write_bytes(data)
        print(f"  {name}")

session_id = Path(session_jsonls[0]).stem
print(f"\n  -> claude --resume {session_id}")
