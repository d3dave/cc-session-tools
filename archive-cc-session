#!/usr/bin/env python3
"""Archive a Claude Code session as a zip file.

Usage: archive-cc-session <session-uuid>
"""

import os, sys, zipfile
from pathlib import Path

sid = sys.argv[1] if len(sys.argv) > 1 else sys.exit("usage: archive-cc-session <session-uuid>")
projects = Path(os.environ.get("CLAUDE_DIR", Path.home() / ".claude")) / "projects"

# Find the session across all project directories
matches = list(projects.glob(f"*/{sid}.jsonl"))
if not matches:
    sys.exit(f"session not found: {sid}")
if len(matches) > 1:
    sys.exit(f"session found in multiple projects, delete duplicates first:\n" +
             "\n".join(f"  {m}" for m in matches))

project_dir = matches[0].parent
jsonl = matches[0]
files = [jsonl] + (sorted((project_dir / sid).rglob("*")) if (project_dir / sid).is_dir() else [])
files = [f for f in files if f.is_file()]

out = Path(f"{sid}.zip")
with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as zf:
    for f in files:
        arcname = f.relative_to(project_dir)
        zf.write(f, arcname)
        print(f"  {arcname}")

print(f"\n{out} ({out.stat().st_size / 1024:.0f}KB, {len(files)} file(s))")
