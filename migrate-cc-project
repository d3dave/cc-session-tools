#!/usr/bin/env python3
"""Migrate Claude Code sessions to CWD after a repo rename/move.

Usage: migrate-cc-project <old-project-path>
"""

import os, shutil, sys, uuid
from pathlib import Path

if len(sys.argv) < 2:
    sys.exit("usage: migrate-cc-project <old-project-path>")

old_path = sys.argv[1].rstrip("/")
new_path = os.getcwd()

if not os.path.isabs(old_path):
    sys.exit(f"path must be absolute: {old_path}")
if old_path == new_path:
    sys.exit("old and new paths are the same")

projects_dir = Path(os.environ.get("CLAUDE_DIR", Path.home() / ".claude")) / "projects"
old_project = projects_dir / old_path.replace("/", "-")
new_project = projects_dir / new_path.replace("/", "-")

if not old_project.is_dir():
    sys.exit(f"not found: {old_project}")

sessions = list(old_project.glob("*.jsonl"))
if not sessions:
    sys.exit(f"no sessions in {old_project}")

try:
    answer = input(f"Delete old project directory {old_project} after migration? [y/N] ").strip().lower()
except (EOFError, KeyboardInterrupt):
    answer = ""
delete_old = answer == "y"

new_project.mkdir(parents=True, exist_ok=True)
print(f"\nMigrating {len(sessions)} session(s): {old_path} -> {new_path}\n")

for session_jsonl in sorted(sessions, key=lambda p: p.stat().st_mtime, reverse=True):
    old_sid = session_jsonl.stem
    new_sid = old_sid if delete_old else str(uuid.uuid4())

    subdir = old_project / old_sid
    files = [session_jsonl]
    if subdir.is_dir():
        files += sorted(subdir.rglob("*"))

    for src in files:
        if not src.is_file():
            continue
        rel = str(src.relative_to(old_project))
        dst = new_project / Path(rel.replace(old_sid, new_sid, 1))
        if dst.exists():
            print(f"  skip {dst.name}")
            continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        if src.suffix in (".jsonl", ".json"):
            dst.write_text(src.read_text().replace(old_path, new_path))
        else:
            shutil.copy2(src, dst)
        print(f"  {dst.name}")
    print(f"  -> claude --resume {new_sid}\n")

if delete_old:
    shutil.rmtree(old_project)
    print(f"Deleted {old_project}")
else:
    print(f"Kept {old_project}")
